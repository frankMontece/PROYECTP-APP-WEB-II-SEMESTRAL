# Configuracion de la API del Condominio.
# Copia este archivo a .env y ajusta los valores: cp .env.example .env
# El archivo .env NO se sube a Git (debe estar en .gitignore).

PUERTO=:8080
RUTA_DB=condominio.db
JWT_SECRETO=cambia-esto-por-un-secreto-largo-y-unico
JWT_DURACION=24h
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s